# Optional. If set, visiting the app requires this single shared password.
# Leave empty (or unset) to keep the deployment open.
AUTH_PASSWORD=

# Optional. Secret used to sign the session cookie (HMAC-SHA256).
# Generate one with: openssl rand -base64 32
# If omitted, a value derived from AUTH_PASSWORD is used.
AUTH_SECRET=

# Optional. Canonical origin, used for Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
