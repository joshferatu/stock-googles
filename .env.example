# Optional. If set, visiting the app requires this single shared password.
# Leave empty (or unset) to keep the deployment open.
AUTH_PASSWORD=

# Optional. Secret used to sign the session cookie (HMAC-SHA256).
# Generate one with: openssl rand -base64 32
# If omitted, a value derived from AUTH_PASSWORD is used.
AUTH_SECRET=

# Optional. Canonical origin, used for Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional. Google SSO is enabled when both values are set.
# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this Google account domain may sign in (default: gmail.com).
GOOGLE_ALLOWED_DOMAIN=gmail.com

# Local/E2E only: simulates the Google step without a client.
# Ignored on Vercel production. Never set this in a real deployment.
GOOGLE_AUTH_MOCK=
