# Neon (server-side only). Provisioned by Vercel's Neon integration:
# Vercel injects DATABASE_URL and DATABASE_URL_UNPOOLED into Preview/Production.
# They are encrypted, so `vercel env pull` downloads a placeholder: copy the
# values from Vercel -> Storage -> Neon -> .env.local for local development.
DATABASE_URL=
# Unpooled connection, used by migrations (`npm run db:migrate`).
DATABASE_URL_UNPOOLED=

# Shared market-data cache (Upstash Redis from the Vercel Marketplace).
# Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN into Preview and Production;
# the TCP forms (KV_URL, REDIS_URL) are unused because the client speaks REST.
# Optional: without them the server uses its in-process cache only, which is what
# local dev and E2E do. The Vercel values are "sensitive", so copy them from
# Vercel -> Storage -> Upstash -> REST API if you want the shared layer locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required. HMAC secret for signed session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Required for sign-in: Google SSO is the only authentication method.
# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this Google account domain may sign in (default: gmail.com).
GOOGLE_ALLOWED_DOMAIN=gmail.com

# Optional. Shown as the privacy contact on /privacy (use your support email).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. Canonical origin, used for the OAuth redirect URI and Open Graph metadata.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Local/E2E only: simulates Google without a client.
# Ignored on Vercel production. Never set this in a real deployment.
GOOGLE_AUTH_MOCK=
